---
import Layout from "@/layouts/Layout.astro";
import FlashcardDashboard from "@/components/FlashcardDashboard";
import Topbar from "@/components/Topbar.astro";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-5xl">
      <Topbar />

      <div class="mb-8 rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
        <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Dashboard
        </h1>
        <p class="text-blue-100/80">
          Welcome, <span class="font-semibold text-white">{user?.email}</span>
        </p>
        <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
        <div class="mt-6 flex items-center justify-center gap-3">
          <a
            href="/study"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Rozpocznij naukę
          </a>
        </div>
      </div>

      <FlashcardDashboard client:load />
    </div>
  </div>
</Layout>
