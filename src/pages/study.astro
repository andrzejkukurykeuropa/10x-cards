---
import Layout from "@/layouts/Layout.astro";
import StudySession from "@/components/StudySession";
import Topbar from "@/components/Topbar.astro";
---

<Layout title="Sesja nauki">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-5xl">
      <Topbar />

      <div class="mb-8 rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <div class="mb-4 flex items-center justify-between">
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Sesja nauki
          </h1>
          <a href="/dashboard" class="text-sm text-blue-100/80 hover:text-white">← Powrót do dashboardu</a>
        </div>
        <StudySession client:load />
      </div>
    </div>
  </div>
</Layout>
