---
import Layout from "@/layouts/Layout.astro";
import AccountDeletion from "@/components/AccountDeletion";
import Topbar from "@/components/Topbar.astro";

const { user } = Astro.locals;
---

<Layout title="Ustawienia">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-5xl">
      <Topbar />

      <div class="mb-8 rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
        <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Ustawienia
        </h1>
        <p class="text-blue-100/80">
          Zalogowano jako <span class="font-semibold text-white">{user?.email}</span>
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h2 class="mb-2 text-xl font-semibold">Usuń konto</h2>
        <p class="mb-4 text-sm text-blue-100/70">
          Trwałe usunięcie konta skasuje wszystkie Twoje dane, w tym fiszki. Tej operacji nie można cofnąć.
        </p>
        <AccountDeletion email={user?.email} client:load />
      </div>
    </div>
  </div>
</Layout>
