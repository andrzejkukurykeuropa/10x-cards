SUPABASE_URL=###
SUPABASE_KEY=###

# Supabase service_role key — ODCZYT/ZAPIS z pominięciem RLS, tylko dla operacji administracyjnych (usuwanie kont). NIE eksponować po stronie klienta.
SUPABASE_SERVICE_ROLE_KEY=###

# Groq API key — get from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenAI API key — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# GitHub token for GitHub Models (free) — get from https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...

# Google Gemini API key (free) — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...