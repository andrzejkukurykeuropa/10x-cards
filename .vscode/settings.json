{
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "astro"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "chat.mcp.serverSampling": {
    "10x-cards/.vscode/mcp.json: exa": {
      "allowedModels": [
        "copilotcli/auto",
        "copilot/auto"
      ]
    }
  }
}
