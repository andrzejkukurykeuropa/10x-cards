SUPABASE_URL=###
SUPABASE_KEY=###

# Supabase service_role key — potrzebny do tworzenia/usuwania kont testowych przez Admin API
# oraz sprzątania danych między testami z pominięciem RLS. Skopiuj wartości z `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=###

# Atrapa klucza Groq — wartość jest fikcyjna i NIGDY nie wychodzi żądanie do Groq.
# Testy generowania AI mockują dostawcę (`vi.mock("@ai-sdk/groq")`); ten klucz służy
# wyłącznie do przepuszczenia bramki `!GROQ_API_KEY` w `src/pages/api/generate-flashcards.ts`.
GROQ_API_KEY=test-dummy-key-not-real
